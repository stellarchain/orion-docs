{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "af4953a04fa7f90854db6a8dad73875c",
  "name": "orion-docs",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "docs/.vitepress/dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "ORION_BUCKET",
      "bucket_name": "orion"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DOCS_ANALYTICS",
      "dataset": "orion_docs_analytics"
    },
    {
      "binding": "API_ANALYTICS",
      "dataset": "orion_api_telemetry"
    }
  ]
}
